        CSSS
      </div>
      <div>
        <span class="text-xs font-black uppercase tracking-widest text-blue-300 block mb-0.5">
          Apostolic Vicariate of Hawassa
        </span>
        <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight leading-none">
          Comboni Catholic Senior Secondary School
        </h1>
      </div>
    </div>

    <!-- Document Reference Badge & Navigation -->
    <div class="flex items-center gap-4 sm:gap-6">
      <div class="hidden xl:inline-flex items-center px-6 py-2 bg-blue-900 rounded-full border border-blue-700 text-blue-100 font-black text-sm uppercase tracking-wider shadow-inner">
        Ref. No: CCSSS/OPS-HR/2026/001
      </div>
      
      <a 
        href="/dashboard" 
        class="px-5 sm:px-6 py-3 bg-blue-800 hover:bg-blue-700 text-white font-black text-sm sm:text-base rounded-2xl transition-all duration-200 shadow-lg border-2 border-blue-500 hover:scale-105 flex items-center gap-2"
      >
        <span>←</span>
        <span>Core Dashboard</span>
      </a>

      <!-- Functional Logout Button -->
      <button 
        type="button"
        id="logout-btn" 
        class="px-5 sm:px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-black text-sm sm:text-base rounded-2xl transition-all duration-200 shadow-lg border-2 border-red-400 hover:scale-105 flex items-center gap-2 shrink-0 cursor-pointer"
      >
        <span>Logout</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  import { auth } from "../../firebase/client"; // Adjust relative path if needed
  import { signOut } from "firebase/auth";

  const logoutBtn = document.getElementById("logout-btn");

  logoutBtn?.addEventListener("click", async () => {
    try {
      // 1. Sign out of Firebase client
      if (auth) {
        await signOut(auth);
      }
    } catch (err) {
      console.error("Firebase client signout error:", err);
    } finally {
      // 2. Clear browser cookies directly as fallback
      document.cookie = "__session=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;";
      
      // 3. Navigate to signout API (which deletes HTTP-only cookie on server and redirects to /login)
      window.location.href = "/api/auth/signout";
    }
  });
</script>

