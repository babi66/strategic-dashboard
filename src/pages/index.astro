---
// src/pages/index.astro
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Strategic Dashboard</title>
</head>
<body class="min-h-screen flex flex-col justify-center items-center p-6 antialiased">
  <div class="max-w-lg w-full text-center space-y-6">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-2xl shadow-inner">
      📊
    </div>
    
    <div class="space-y-2">
      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Strategic Dashboard
      </h1>
      <p class="text-slate-400 text-sm sm:text-base">
        Welcome to your administrative hub. Monitor analytics, manage user activities, and oversee operations in real time.
      </p>
    </div>

    <div class="pt-4 flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href="/signin"
        class="px-6 py-3 rounded-xl font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition-all shadow-lg shadow-indigo-600/25 text-sm"
      >
        Sign In to Portal
      </a>
      <a
        href="/dashboard"
        class="px-6 py-3 rounded-xl font-semibold bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 transition-all text-sm"
      >
        Go to Dashboard
      </a>
    </div>
  </div>
</body>
</html>